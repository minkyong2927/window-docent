<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 차량 기기가 아니어도 설치 · 실행되게 (FusedLocation 묶음이 required=true 로 선언한 것을 false 로 지킴) -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false"
        tools:replace="android:required" />

    <!-- Pleos Connect 읽기 권한만 (차량 제어 CONTROL_… 권한은 쓰지 않음) -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.READ_CAR_STEERING" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- 내비에 경유지 넣기(가자) · 경로 요청 (NaviHelper addWaypoint · requestRoute · 내비 요청이고 차량 제어가 아님 · 11/14 에뮬레이터에서 없으면 SecurityException) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- 위치(속도 계산용) · 실행 중에 요청함 -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- Pleos 음성: 해설 말하기(TextToSpeech) · 음성 명령 듣기(SpeechToText). 없으면 SDK 가 SecurityException 을 던짐 (11/14 에뮬레이터에서 앱이 바로 꺼진 까닭) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
